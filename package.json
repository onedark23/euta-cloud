{
  "name": "euta-cloud",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose -f deploy/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f deploy/docker-compose.yml down",
    "test": "pnpm db:up && pnpm -r build && vitest run",
    "test:only": "vitest run",
    "dev": "pnpm --filter @euta-cloud/server dev",
    "test:e2e": "pnpm db:up && pnpm -r build && pnpm --filter @euta-cloud/web e2e"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^4.1"
  }
}

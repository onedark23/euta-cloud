{
  "name": "@euta-cloud/server",
  "version": "0.1.0",
  "private": true,
  "description": "euta cloud server: REST API, auth (Better Auth), change feed SSE, static web",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate-cli.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.33",
    "@better-auth/drizzle-adapter": "1.6.33",
    "@euta-cloud/shared": "workspace:*",
    "@euta/core": "link:../../../euta-engine/packages/core",
    "@fastify/static": "^10.1.6",
    "@modelcontextprotocol/server": "2.1.0",
    "better-auth": "1.6.33",
    "cron-parser": "^5",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "tar-stream": "^3",
    "zod": "^4.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/pg": "^8.23.1",
    "@types/tar-stream": "^3.1.5",
    "drizzle-kit": "^0.31.11"
  }
}

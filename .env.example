# euta cloud server — copy to .env (git-ignored) or provide via k8s ConfigMap/Secret.
# Values below are for local docker compose only. Never commit real secrets.

DATABASE_URL=postgres://euta:euta-dev-only@localhost:55432/euta
BASE_URL=http://localhost:8080
PORT=8080

# Secrets (k8s Secret in dev/prd). Generate:
#   BETTER_AUTH_SECRET: openssl rand -base64 48
#   CREDENTIALS_KEY:    openssl rand -base64 32   (AES-256-GCM key for test credentials — losing it makes stored credentials unreadable)
BETTER_AUTH_SECRET=
CREDENTIALS_KEY=

# Sign-up. ADMIN_EMAILS is required when SMTP_URL is empty (admin-approval mode).
ALLOWED_EMAIL_DOMAINS=example.com
ADMIN_EMAILS=

# Mail. Unset SMTP_URL → admin-approval sign-up mode (no verification mail).
# Local Mailpit (docker compose): smtp://localhost:51025, inbox UI http://localhost:58025
SMTP_URL=smtp://localhost:51025
MAIL_FROM=euta cloud <no-reply@example.com>

# Company Microsoft login (Entra ID, single-tenant app registration). All three or none; the tenant must be
# the company tenant GUID (not common/organizations/consumers). On → main login button, first login =
# active account, new email sign-ups closed. Redirect URI: <BASE_URL>/api/auth/callback/microsoft
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Runs / runner (internal API on its own port — expose it only inside the cluster, never via ingress)
INTERNAL_PORT=8081
# Shared runner token (k8s Secret, same value in the runner's EUTA_RUNNER_TOKEN). Generate: openssl rand -hex 32
RUNNER_TOKEN=
# Result files (server PVC). Retention: 30 days + total cap, oldest first.
RESULTS_DIR=data/results
# RESULT_RETENTION_DAYS=30
# RESULT_MAX_TOTAL=12Gi
# RESULT_MAX_RUN=2Gi
# RUN_LEASE_TTL_MS=120000
# RUNNER_HEARTBEAT_MS=5000
# DEV/TEST ONLY — skips the public-address precheck so runs can target 127.0.0.1 / host.docker.internal
# (engine fixture site). Never set in a deployed environment.
# ALLOW_PRIVATE_TARGETS=true

# Optional
# AUTH_RATE_LIMIT=true
# DEVICE_CLIENT_IDS=euta-app
# FEED_RETENTION_DAYS=7
# WEB_DIST=/app/packages/web/dist
# LOG_LEVEL=info
